<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:importantForAccessibility="yes"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:text="@string/widget_sign_in"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/sleep_column"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/sleep_dial"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/widget_sleep"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/sleep_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="@string/widget_sleep"
            android:textAllCaps="true"
            android:textColor="#BABAC0"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/recovery_column"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/recovery_dial"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/widget_recovery"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/recovery_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="@string/widget_recovery"
            android:textAllCaps="true"
            android:textColor="#BABAC0"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/strain_column"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/strain_dial"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/widget_strain"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/strain_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="@string/widget_strain"
            android:textAllCaps="true"
            android:textColor="#BABAC0"
            android:textSize="10sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_refresh_hit"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/widget_refresh">

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_refresh"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/widget_refresh" />

        <ProgressBar
            android:id="@+id/widget_refreshing"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
