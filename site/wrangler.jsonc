// Static assets only: no Worker script, so nothing runs per request. Build first (`pnpm build`), then `wrangler deploy`.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "pulse-site",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "pulse.portlabs.in", "custom_domain": true }],
  "workers_dev": true
}
