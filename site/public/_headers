# Cloudflare Pages applies these headers to static files; Astro endpoint headers only apply during development.

# Hashed by Astro (CSS, JS, images, fonts): the file name changes with the content, so cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed: revalidate daily.
/og.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Markdown alternatives stay crawlable for agents without duplicating the HTML pages in search results.
/
  X-Robots-Tag: index, follow, max-image-preview:large
/metrics/*
  X-Robots-Tag: index, follow, max-image-preview:large
/compare/*
  X-Robots-Tag: index, follow, max-image-preview:large
/glossary/
  X-Robots-Tag: index, follow, max-image-preview:large
/404.html
  X-Robots-Tag: noindex

/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex, follow
  Link: </llms.txt>; rel="describedby"
/llms.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex, follow
