---
// Native <details>, so the answers open without any script and stay in the HTML for search engines.
import type { Faq } from "../data/metrics"

interface Props {
  items: Faq[]
  heading?: string
}
const { items, heading = "Questions" } = Astro.props
---

<section class="faq" aria-labelledby="faq-h">
  <h2 id="faq-h">{heading}</h2>
  <div class="list">
    {
      items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p set:html={f.a} />
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq h2 {
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    margin-bottom: 24px;
  }
  .list {
    max-width: 780px;
  }
  details {
    box-shadow: inset 0 -1px 0 rgb(255 255 255 / 0.08);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    padding: 14px 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 1.0625rem;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "";
    flex: none;
    width: 10px;
    height: 10px;
    margin-right: 4px;
    border-right: 2px solid var(--muted-foreground);
    border-bottom: 2px solid var(--muted-foreground);
    rotate: 45deg;
    translate: 0 -3px;
    transition: rotate 220ms var(--ease-standard), translate 220ms var(--ease-standard);
  }
  details[open] summary::after {
    rotate: 225deg;
    translate: 0 3px;
  }
  details p {
    max-width: 68ch;
    padding: 0 0 20px;
    color: var(--foreground-secondary);
  }
</style>
