---
// A framed app screenshot (device or window frame and margin are in the image, see site/scripts/shots.mjs).
import { Picture } from "astro:assets"
import { shot as getShot, isPhone } from "../lib/shots"
import type { Shot } from "../data/metrics"

interface Props {
  shot: Shot
  class?: string
  /** Above the fold: load eagerly with high priority. */
  priority?: boolean
  sizes?: string
}
const { shot, class: className, priority = false, sizes } = Astro.props
const { src, alt } = getShot(shot)
const phone = isPhone(shot)
const widths = phone ? [280, 420, 640, 960] : [640, 960, 1440, 2000]
---

<Picture
  src={src}
  alt={alt}
  formats={["avif", "webp"]}
  widths={widths}
  sizes={sizes ?? (phone ? "(max-width: 700px) 70vw, 320px" : "(max-width: 900px) 100vw, 900px")}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : undefined}
  decoding="async"
  class:list={["shot", phone ? "phone" : "laptop", className]}
/>
