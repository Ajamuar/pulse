---
// A framed app screenshot (device or window frame and margin are in the image, see site/scripts/shots.mjs).
import { Picture } from "astro:assets"
import { shot as getShot, isPhone } from "../lib/shots"
import type { Shot } from "../data/metrics"

interface Props {
  shot: Shot
  class?: string
  /** Above the fold: load eagerly with high priority. */
  priority?: boolean
  sizes?: string
}
const { shot, class: className, priority = false, sizes } = Astro.props
const { src, alt } = getShot(shot)
const phone = isPhone(shot)
// Steps of about 1.25x up to the source width, so a phone at 1x-3x always gets a file a little larger than it draws
// (a 230 px strip phone: 240, 480, 720) and never one that is much larger or smaller.
const widths = phone ? [240, 300, 380, 480, 600, 720, 900, 1100, 1398] : [640, 800, 1000, 1240, 1540, 1920, 2400, 3040]
---

<Picture
  src={src}
  alt={alt}
  formats={["avif"]}
  fallbackFormat="webp"
  widths={widths}
  sizes={sizes ?? (phone ? "(max-width: 700px) 70vw, 320px" : "(max-width: 900px) 100vw, 900px")}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : undefined}
  decoding="async"
  class:list={["shot", phone ? "phone" : "laptop", className]}
/>
