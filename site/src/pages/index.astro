---
import Base from "../layouts/Base.astro"
import Faq from "../components/Faq.astro"
import Screenshot from "../components/Screenshot.astro"
import { METRICS, metricPath } from "../data/metrics"
import { COMPARISONS } from "../data/compare"
import { REPO, SETUP_GUIDE, LICENSE_URL } from "../config"
import { faqPage, softwareApp } from "../lib/schema"

const title = "Pulse: recovery and strain for Fitbit Air, self-hosted"
const description =
  "Open-source, self-hosted app that turns your Fitbit Air's Google Health data into daily Recovery, Strain, Sleep, Pulse Age, Stress and Energy Bank scores."

// The three scores of the home screen first, then the rest in the app's order.
const lead = ["recovery", "sleep", "strain"]
const metrics = [...METRICS].sort((a, b) => {
  const ia = lead.indexOf(a.appSlug), ib = lead.indexOf(b.appSlug)
  return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib)
})

const flow = [
  { name: "Fitbit Air", detail: "Records heart rate, sleep and nightly vitals, and syncs to your phone." },
  { name: "Google Health app", detail: "Holds the band's data in your Google account, as it always has." },
  { name: "Google Health API", detail: "Pulse reads it with an OAuth client from your own Google Cloud project." },
  { name: "Your server", detail: "One Docker container scores every day and keeps the history in SQLite." },
  { name: "Your browser", detail: "Open it on your phone or laptop, and install it like an app." },
]

const faq = [
  {
    q: "Is Pulse free?",
    a: `Yes, for personal and other noncommercial use, under the <a href="${LICENSE_URL}">PolyForm Noncommercial 1.0.0</a> license. Selling it, or putting it inside a commercial product, is not allowed.`,
  },
  {
    q: "What do I need to run it?",
    a: `A Fitbit Air paired with the Google Health app, a Google Cloud project for the OAuth client, and any machine that runs Docker: a home server, a NAS or a small cloud VM. To reach it from your phone, give it an HTTPS address with a tunnel or reverse proxy. The <a href="${SETUP_GUIDE}">setup guide</a> covers each step.`,
  },
  {
    q: "Can I try it before connecting my Google account?",
    a: "Yes. Demo mode generates 180 days of realistic data on your laptop, with no Google account and nothing sent anywhere.",
  },
  {
    q: "Where does my data go?",
    a: "From Google Health to your own server, and nowhere else. The app talks only to Google's sign-in and Health API. There is no Pulse account, no Pulse cloud and no analytics in the app.",
  },
  {
    q: "Does it work with other Fitbit devices?",
    a: "Pulse is built and tested with the Fitbit Air. It reads from the Google Health API, so other devices that sync to the Google Health app may work, but the scores are tuned to the data the Air records.",
  },
  {
    q: "The old Fitbit Web API is shutting down. Does that affect Pulse?",
    a: "No. Pulse uses the newer Google Health API from the start, with your own Google OAuth client.",
  },
  {
    q: "Can several people share one Pulse?",
    a: "No. Each instance belongs to one owner, set by the Google account allowed to sign in. Everyone runs their own, so nobody's health data sits on someone else's server.",
  },
  {
    q: "Are the scores medical advice?",
    a: "No. Pulse is a wellness tool, not a medical device. Every score is an estimate from a wrist sensor, and each metric page lists its limits.",
  },
  {
    q: "Is Pulse made by the reference app or Google?",
    a: "No. Pulse is an independent open-source project. Its look and scales are inspired by the the reference app app; its scoring is ported from the open-source noop project and published in full.",
  },
]

const schema = [softwareApp(Astro.site!, description), faqPage(faq)]
const rest = metrics.length - 3
---

<Base title={title} description={description} schema={schema}>
  <section class="hero" aria-labelledby="hero-h">
    <svg class="beat" viewBox="0 0 1600 200" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 120H900L932 52L964 136L980 120H1600" pathLength="1"></path>
    </svg>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 id="hero-h">Recovery, strain and sleep scores for your Fitbit Air</h1>
        <p class="sub">Open source and self-hosted. Pulse turns your Google Health data into daily scores, on a server you own.</p>
        <div class="actions">
          <a class="button button-primary" href={SETUP_GUIDE}>Self-host Pulse</a>
          <a class="button button-quiet" href={REPO}>View source</a>
        </div>
      </div>
      <div class="hero-art">
        <Screenshot shot="laptop-strain" class="art-laptop" sizes="(max-width: 960px) 0px, 720px" />
        <Screenshot shot="phone-home" class="art-phone" priority sizes="(max-width: 960px) 66vw, 300px" />
      </div>
    </div>
  </section>

  <section class="wrap metrics" aria-labelledby="metrics-h">
    <div class="metrics-intro">
      <h2 id="metrics-h">Three numbers each morning. {rest} more when you want them.</h2>
      <p>
        Sleep, Recovery and Strain on the home screen, the way you would expect. Underneath sit Pulse Age, Stress, Energy Bank, a sleep planner and more. Every one is
        explained in full, with its inputs, weights, limits and sources.
      </p>
      <a class="all" href="/metrics/">How each score works</a>
    </div>
    <ul class="metric-list">
      {
        metrics.map((m) => (
          <li>
            <a href={metricPath(m)}>
              <span class="m-name">{m.name}</span>
              <span class="m-sum">{m.summary}</span>
              {m.scale && (
                <span class="m-strip" aria-hidden="true">
                  {m.scale.bands.map((b, i) => (
                    <i style={`flex-grow:${(m.scale!.bands[i + 1]?.from ?? m.scale!.max) - b.from};background:${b.color}`} />
                  ))}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="screens" aria-labelledby="screens-h">
    <div class="wrap">
      <h2 id="screens-h">Built for the phone in your pocket and the laptop on your desk</h2>
      <div class="screens-grid">
        <figure class="s-wide">
          <Screenshot shot="laptop-health" sizes="(max-width: 860px) 100vw, 760px" />
          <figcaption>Health: Pulse Age, nightly vitals, stress and fitness on one screen.</figcaption>
        </figure>
        <figure>
          <Screenshot shot="phone-sleep" sizes="(max-width: 860px) 45vw, 200px" />
          <figcaption>Sleep Performance against your own need.</figcaption>
        </figure>
        <figure>
          <Screenshot shot="phone-health" sizes="(max-width: 860px) 45vw, 200px" />
          <figcaption>Pulse Age and Pace of Aging.</figcaption>
        </figure>
      </div>
      <p class="demo-note">Screenshots from demo mode, with generated data.</p>
    </div>
  </section>

  <section class="wrap flow" aria-labelledby="flow-h">
    <h2 id="flow-h">How your data gets to Pulse</h2>
    <ol class="flow-list">
      {
        flow.map((f) => (
          <li>
            <span class="f-name">{f.name}</span>
            <span class="f-detail">{f.detail}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="privacy" aria-labelledby="privacy-h">
    <div class="wrap privacy-grid">
      <h2 id="privacy-h">Your health data stays on a machine you control.</h2>
      <dl class="facts">
        <div>
          <dt>No Pulse account</dt>
          <dd>You sign in with your own Google account, to your own instance. There is no Pulse service to sign up for.</dd>
        </div>
        <div>
          <dt>No analytics in the app</dt>
          <dd>The app talks to Google's sign-in and Health API, and nothing else.</dd>
        </div>
        <div>
          <dt>One owner per instance</dt>
          <dd>Only the Google account you name can sign in. Nobody else's data is on your server, and yours is on nobody else's.</dd>
        </div>
        <div>
          <dt>Leave whenever you like</dt>
          <dd>Disconnecting in Settings also removes Pulse's access in your Google account. The database is one SQLite file you can back up or delete.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="wrap start" aria-labelledby="start-h">
    <h2 id="start-h">Get started</h2>
    <p class="start-lede">Try the demo on your laptop in a few commands, then point it at your own data. You need Node 24 and pnpm for the demo, Docker for a server.</p>
    <div class="steps">
      <div class="step">
        <h3>Try the demo</h3>
        <pre><code>git clone https://github.com/adityaongit/pulse.git
cd pulse
pnpm install
cp .env.example .env
pnpm dev</code></pre>
        <p>Open localhost:3000 and choose Continue with demo data.</p>
      </div>
      <div class="step">
        <h3>Run it on a server</h3>
        <pre><code># in .env: Google OAuth client, OWNER_EMAIL, TZ
docker compose up -d --build
docker compose logs -f pulse</code></pre>
        <p>Put a tunnel or HTTPS reverse proxy in front, then open it on your phone.</p>
      </div>
    </div>
    <a class="button button-primary guide" href={SETUP_GUIDE}>Read the setup guide</a>
  </section>

  <div class="wrap faq-wrap">
    <Faq items={faq} />
  </div>

  <section class="wrap credits" aria-labelledby="credits-h">
    <h2 id="credits-h">Open source, noncommercial</h2>
    <p>
      Pulse is free to use, change and share for any noncommercial purpose under <a href={LICENSE_URL}>PolyForm Noncommercial 1.0.0</a>. Its recovery, strain and sleep
      scoring is ported from <a href="https://github.com/ryanbr/noop">noop</a>, and <a href="https://github.com/bardesss/haelan">Hælan</a>'s notes on the Google Health API
      saved a lot of trial and error.
    </p>
    <p class="compare-links">
      Weighing it up? {
        COMPARISONS.map((c, i) => (
          <>
            <a href={`/compare/${c.slug}/`}>{c.nav}</a>
            {i < COMPARISONS.length - 1 ? ", " : "."}
          </>
        ))
      }
    </p>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 6vw, 80px) 0 0;
  }
  .beat {
    position: absolute;
    left: 0;
    bottom: 72px;
    width: 100%;
    height: 200px;
    pointer-events: none;
  }
  .beat path {
    fill: none;
    stroke: var(--optimal);
    stroke-opacity: 0.45;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: miter;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: draw 1.6s var(--ease-out-expo) 0.15s both;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 32px;
    align-items: center;
  }
  .hero-copy {
    padding-bottom: 120px;
  }
  h1 {
    font-size: clamp(2.5rem, 5.2vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    max-width: 13ch;
  }
  .sub {
    margin-top: 24px;
    max-width: 38ch;
    color: var(--foreground-secondary);
    font-size: clamp(1.125rem, 1.6vw, 1.3125rem);
    line-height: 1.5;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .hero-art {
    position: relative;
    height: 660px;
    /* The screenshots run off the bottom of the hero; fade them out instead of a hard crop. */
    mask-image: linear-gradient(180deg, #000 72%, transparent 98%);
  }
  .hero-art :global(.art-laptop) {
    position: absolute;
    left: 24%;
    top: 40px;
    width: 720px;
    max-width: none;
    opacity: 0.9;
    animation: rise 1s var(--ease-out-expo) 0.35s both;
  }
  .hero-art :global(.art-phone) {
    position: absolute;
    left: 0;
    top: 120px;
    width: 300px;
    animation: rise 1s var(--ease-out-expo) 0.2s both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 24px;
    }
  }

  /* Metrics */
  .metrics {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 64px;
    margin-top: 160px;
  }
  .metrics-intro {
    align-self: start;
    position: sticky;
    top: 104px;
  }
  .metrics-intro h2,
  .screens h2,
  .flow h2,
  .start h2 {
    font-size: clamp(1.875rem, 3.6vw, 2.75rem);
    letter-spacing: -0.03em;
  }
  .metrics-intro p {
    margin-top: 20px;
    max-width: 44ch;
    color: var(--foreground-secondary);
  }
  .all {
    display: inline-block;
    margin-top: 20px;
    font-weight: 600;
  }
  .metric-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .metric-list li:nth-child(-n + 3) {
    grid-column: 1 / -1;
  }
  .metric-list li:nth-child(-n + 3) .m-name {
    font-size: 1.5rem;
  }
  .metric-list a {
    display: grid;
    gap: 6px;
    padding: 20px 0;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
    text-decoration: none;
  }
  .m-name {
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    transition: color 150ms var(--ease-standard);
  }
  .metric-list a:hover .m-name {
    color: var(--optimal);
  }
  .m-sum {
    color: var(--foreground-secondary);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .m-strip {
    display: flex;
    gap: 2px;
    width: min(100%, 240px);
    height: 4px;
    margin-top: 6px;
  }
  .m-strip i {
    border-radius: 2px;
  }

  /* Screens */
  .screens {
    margin-top: 160px;
    padding: 96px 0 104px;
    background: radial-gradient(90% 70% at 70% 0%, #14302d 0%, transparent 70%), var(--sheet);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), inset 0 -1px 0 rgb(255 255 255 / 0.06);
  }
  .screens h2 {
    max-width: 20ch;
  }
  .screens-grid {
    display: grid;
    grid-template-columns: minmax(0, 3.6fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    margin-top: 56px;
  }
  figure {
    margin: 0;
  }
  figcaption {
    margin-top: 16px;
    color: var(--foreground-secondary);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .screens-grid :global(.phone) {
    border-radius: 22px;
  }
  .demo-note {
    margin-top: 40px;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  /* Flow */
  .flow {
    margin-top: 160px;
  }
  .flow-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }
  .flow-list li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 28px 24px 0 0;
  }
  /* The connector: a line along the top, with a node where each step sits. */
  .flow-list li::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--optimal), var(--strain-text));
    opacity: 0.55;
  }
  .flow-list li::after {
    content: "";
    position: absolute;
    top: -5px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--background);
    box-shadow: inset 0 0 0 2px var(--optimal);
  }
  .flow-list li:nth-child(4)::after {
    background: var(--optimal);
  }
  .f-name {
    font-weight: 600;
    font-size: 1.125rem;
  }
  .f-detail {
    color: var(--foreground-secondary);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  /* Privacy */
  .privacy {
    margin-top: 160px;
  }
  .privacy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 64px;
    padding: clamp(32px, 5vw, 64px);
    border-radius: 28px;
    background: linear-gradient(160deg, #1b2a2b 0%, #161d22 55%, #141a20 100%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08), 0 30px 80px rgb(0 0 0 / 0.35);
  }
  .privacy h2 {
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 36px;
    margin: 0;
  }
  .facts dt {
    font-weight: 600;
  }
  .facts dd {
    margin: 6px 0 0;
    color: var(--foreground-secondary);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* Get started */
  .start {
    margin-top: 160px;
  }
  .start-lede {
    margin-top: 16px;
    max-width: 60ch;
    color: var(--foreground-secondary);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  .step {
    padding: 28px;
    border-radius: 20px;
    background: var(--inset);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.07);
  }
  .step h3 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  pre {
    margin: 16px 0 0;
    padding: 18px 20px;
    overflow-x: auto;
    border-radius: 12px;
    background: #0b0d0f;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
    color: #d7e3ea;
    line-height: 1.7;
    tab-size: 2;
  }
  .step p {
    margin-top: 14px;
    color: var(--foreground-secondary);
    font-size: 0.9375rem;
  }
  .guide {
    margin-top: 28px;
  }

  .faq-wrap {
    margin-top: 160px;
  }

  /* Credits */
  .credits {
    margin-top: 120px;
  }
  .credits h2 {
    font-size: clamp(1.625rem, 3vw, 2.125rem);
  }
  .credits p {
    margin-top: 16px;
    max-width: 68ch;
    color: var(--foreground-secondary);
  }
  .compare-links a {
    color: var(--foreground);
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-copy {
      padding-bottom: 0;
    }
    .hero-art {
      min-height: 0;
      height: auto;
      display: flex;
      justify-content: center;
      max-height: 560px;
      overflow: hidden;
      margin-top: 8px;
      mask-image: linear-gradient(180deg, #000 70%, transparent);
    }
    .hero-art :global(.art-laptop) {
      display: none;
    }
    .hero-art :global(.art-phone) {
      position: static;
      width: min(66vw, 300px);
    }
    .beat {
      bottom: 180px;
    }
    .metrics {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-top: 96px;
    }
    .metrics-intro {
      position: static;
    }
    .screens,
    .flow,
    .privacy,
    .start,
    .faq-wrap {
      margin-top: 112px;
    }
    .screens-grid {
      grid-template-columns: 1fr 1fr;
    }
    .s-wide {
      grid-column: 1 / -1;
    }
    .flow-list {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-left: 28px;
    }
    .flow-list li {
      padding: 0;
    }
    .flow-list li::before {
      top: 6px;
      bottom: -34px;
      left: -23px;
      right: auto;
      width: 2px;
      height: auto;
      background: linear-gradient(180deg, var(--optimal), var(--strain-text));
    }
    .flow-list li:last-child::before {
      display: none;
    }
    .flow-list li::after {
      top: 1px;
      left: -28px;
    }
    .privacy-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .metric-list {
      grid-template-columns: 1fr;
    }
    .facts {
      grid-template-columns: 1fr;
    }
    .step {
      padding: 20px;
    }
  }
</style>
