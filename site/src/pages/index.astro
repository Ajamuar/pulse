---
import Base from "../layouts/Base.astro"
import Faq from "../components/Faq.astro"
import Screenshot from "../components/Screenshot.astro"
import { METRICS, metricPath, metricByAppSlug } from "../data/metrics"
import { COMPARISONS } from "../data/compare"
import { REPO, SETUP_GUIDE, LICENSE_URL, CONTACT_EMAIL } from "../config"
import { faqPage, softwareApp } from "../lib/schema"
import type { Shot } from "../data/metrics"

const title = "Pulse: recovery and strain for Fitbit Air, self-hosted"
const description =
  "Open-source, self-hosted app that turns your Fitbit Air's Google Health data into daily Recovery, Strain, Sleep, Pulse Age, Stress and Energy Bank scores."

const href = (appSlug: string) => {
  const m = metricByAppSlug(appSlug)
  return m ? metricPath(m) : "/metrics/"
}

// The home screen's three dials, with example values. `max` is the dial's full scale.
const dials = [
  { name: "Sleep", value: 86, max: 100, unit: "%", color: "var(--sleep)", line: "How well last night's sleep met your need.", href: href("sleep") },
  { name: "Recovery", value: 74, max: 100, unit: "%", color: "var(--recovery-green)", line: "How ready your body is to take on strain today.", href: href("recovery") },
  { name: "Strain", value: 12.4, max: 21, unit: "", color: "var(--strain)", line: "The day's cardiovascular load, from 0 to 21.", href: href("strain") },
]

const strip: { shot: Shot; name: string; line: string }[] = [
  { shot: "phone-strain", name: "Strain", line: "The day so far, and today's Strain Target." },
  { shot: "phone-sleep", name: "Sleep", line: "Sleep Performance against your own need." },
  { shot: "phone-health", name: "Health", line: "Pulse Age and Pace of Aging." },
  { shot: "phone-health-monitor", name: "Health Monitor", line: "Heart rhythm and body measurements." },
  { shot: "phone-journal", name: "Journal", line: "Log water, food, weight and mood." },
]

const story: { shot: Shot; name: string; text: string }[] = [
  {
    shot: "laptop-dashboard-editor",
    name: "My Dashboard",
    text: "Choose which metrics sit on Home and in what order: heart rate variability first and steps last, or the other way round.",
  },
  { shot: "laptop-trends", name: "Trends", text: "Recovery, sleep, activity and body metrics by week, month, six months or year, each with averages to compare against." },
  {
    shot: "laptop-health-monitor",
    name: "Health Monitor",
    text: "Last night's vitals against your normal range, ECG readings and irregular rhythm notifications, weight and body fat.",
  },
  { shot: "laptop-journal", name: "Journal", text: "Log your day, check in each evening, and see which habits move the next morning's Recovery." },
]

const flow = [
  { name: "Fitbit Air", detail: "Records heart rate, sleep and nightly vitals, and syncs to your phone." },
  { name: "Google Health app", detail: "Holds the band's data in your Google account, as it always has." },
  { name: "Google Health API", detail: "Pulse reads it with an OAuth client from your own Google Cloud project." },
  { name: "Your server", detail: "One Docker container scores every day and keeps the history in SQLite." },
  { name: "Your browser", detail: "Open it on your phone or laptop, and install it like an app." },
]

const facts = [
  { t: "No Pulse account", d: "You sign in with your own Google account, to your own instance. There is no Pulse service to sign up for." },
  { t: "No analytics in the app", d: "The app talks to Google's sign-in and Health API, and nothing else." },
  { t: "One owner per instance", d: "Only the Google account you name can sign in. Nobody else's data is on your server, and yours is on nobody else's." },
  { t: "Leave whenever you like", d: "Disconnecting removes Pulse's access in your Google account. The database is one SQLite file you can back up or delete." },
]

const faq = [
  {
    q: "Is Pulse free?",
    a: `Yes, for personal and other noncommercial use, under the <a href="${LICENSE_URL}">PolyForm Noncommercial 1.0.0</a> license. Selling it, or putting it inside a commercial product, is not allowed.`,
  },
  {
    q: "What do I need to run it?",
    a: `A Fitbit Air paired with the Google Health app, a Google Cloud project for the OAuth client, and any machine that runs Docker: a home server, a NAS or a small cloud VM. To reach it from your phone, give it an HTTPS address with a tunnel or reverse proxy. The <a href="${SETUP_GUIDE}">setup guide</a> covers each step.`,
  },
  {
    q: "Can I try it before connecting my Google account?",
    a: "Yes. Demo mode generates 180 days of realistic data on your laptop, with no Google account and nothing sent anywhere.",
  },
  {
    q: "Where does my data go?",
    a: "From Google Health to your own server, and nowhere else. The app talks only to Google's sign-in and Health API. There is no Pulse account, no Pulse cloud and no analytics in the app.",
  },
  {
    q: "Does it work with other Fitbit devices?",
    a: "Pulse is built and tested with the Fitbit Air. It reads from the Google Health API, so other devices that sync to the Google Health app may work, but the scores are tuned to the data the Air records.",
  },
  {
    q: "The old Fitbit Web API is shutting down. Does that affect Pulse?",
    a: "No. Pulse uses the newer Google Health API from the start, with your own Google OAuth client.",
  },
  {
    q: "Can several people share one Pulse?",
    a: "No. Each instance belongs to one owner, set by the Google account allowed to sign in. Everyone runs their own, so nobody's health data sits on someone else's server.",
  },
  {
    q: "Are the scores medical advice?",
    a: "No. Pulse is a wellness tool, not a medical device. Every score is an estimate from a wrist sensor, and each metric page lists its limits.",
  },
  {
    q: "Is Pulse affiliated with a wearable company?",
    a: `No. Pulse is a free project by one independent developer, with no intention of competing with WHOOP or any other company. It uses no WHOOP device, data, code or assets, and every score comes from your own Google Health data. The interface takes design inspiration from apps the developer admires. If you represent WHOOP or any other company and have a concern, please email <a href="mailto:${CONTACT_EMAIL}">${CONTACT_EMAIL}</a> and it will be changed or taken down.`,
  },
]

const schema = [softwareApp(Astro.site!, description), faqPage(faq)]
const R = 88
---

<Base title={title} description={description} schema={schema}>
  <section class="hero" aria-labelledby="hero-h" data-observe>
    <svg class="beat" viewBox="0 0 1600 200" preserveAspectRatio="none" aria-hidden="true">
      <path class="beat-base" d="M0 130H520L540 112L556 130H760L782 46L806 168L824 130H1060L1080 112L1096 130H1600" pathLength="1"></path>
      <path class="beat-pulse" d="M0 130H520L540 112L556 130H760L782 46L806 168L824 130H1060L1080 112L1096 130H1600" pathLength="1"></path>
    </svg>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 id="hero-h">Recovery, strain and sleep scores for your Fitbit Air</h1>
        <p class="sub">Open source and self-hosted. Pulse turns your Google Health data into daily scores, on a server you own.</p>
        <div class="actions">
          <a class="button button-primary" href={SETUP_GUIDE}>Self-host Pulse</a>
          <a class="button button-quiet" href={REPO}>View source</a>
        </div>
      </div>
      <div class="stage">
        <div class="layer layer-laptop">
          <Screenshot shot="laptop-home" class="dev dev-laptop" priority sizes="(max-width: 960px) 100vw, 720px" />
        </div>
        <div class="layer layer-phone">
          <Screenshot shot="phone-recovery" class="dev dev-phone" priority sizes="(max-width: 960px) 44vw, 240px" />
        </div>
      </div>
    </div>
  </section>

  <section class="wrap sec dials" aria-labelledby="dials-h" data-observe>
    <h2 id="dials-h">Three numbers each morning</h2>
    <p class="lede">Sleep, Recovery and Strain open the home screen, each scored against your own baselines.</p>
    <ul class="dial-list">
      {
        dials.map((d) => (
          <li>
            <a class="dial" href={d.href} style={`--c:${d.color}`}>
              <span class="ring">
                <svg viewBox="0 0 200 200" aria-hidden="true">
                  <circle class="track" cx="100" cy="100" r={R} pathLength="100" />
                  <circle class="arc" cx="100" cy="100" r={R} pathLength="100" style={`--p:${((d.value / d.max) * 100).toFixed(1)}`} />
                </svg>
                <span class="value num">
                  <span class="visually-hidden">
                    {d.value}
                    {d.unit}
                  </span>
                  <span aria-hidden="true" data-count={d.value}>
                    {d.value}
                  </span>
                  {d.unit && <small aria-hidden="true">{d.unit}</small>}
                </span>
              </span>
              <span class="d-name">{d.name}</span>
              <span class="d-line">{d.line}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="note">Example values. Each score has its own page with its inputs, weights and limits.</p>
  </section>

  <section class="sec screens" aria-labelledby="screens-h">
    <div class="wrap">
      <h2 id="screens-h">Made for the phone in your pocket</h2>
      <p class="lede">Pulse is a web app you add to your home screen from the browser. Screens from demo mode, with generated data.</p>
    </div>
    <ul class="strip">
      {
        strip.map((s) => (
          <li>
            <figure>
              <div class="drift">
                <Screenshot shot={s.shot} sizes="(max-width: 760px) 62vw, 230px" />
              </div>
              <figcaption>
                <strong>{s.name}</strong>
                {s.line}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap sec story" aria-labelledby="story-h">
    <h2 id="story-h">On a laptop, the whole picture at once</h2>
    <div class="story-grid">
      <ol class="steps-list">
        {
          story.map((s, i) => (
            <li class="step" data-step={i}>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
              <Screenshot shot={s.shot} class="inline-shot" sizes="100vw" />
            </li>
          ))
        }
      </ol>
      <div class="screen-stack" aria-hidden="true" data-active="0">
        {story.map((s, i) => <Screenshot shot={s.shot} class={`stack-shot s${i}`} sizes="760px" />)}
      </div>
    </div>
  </section>

  <section class="wrap sec metrics" aria-labelledby="metrics-h">
    <h2 id="metrics-h">{METRICS.length} scores, each explained in full</h2>
    <p class="lede">Inputs, weights, bands, limits and sources for every number Pulse shows. <a href="/metrics/">Browse the metrics</a></p>
    <ul class="metric-grid">
      {
        METRICS.map((m) => (
          <li>
            <a href={metricPath(m)}>
              <span class="m-name">{m.name}</span>
              <span class="m-sum">{m.summary}</span>
              {m.scale && (
                <span class="m-strip" aria-hidden="true">
                  {m.scale.bands.map((b, i) => (
                    <i style={`flex-grow:${(m.scale!.bands[i + 1]?.from ?? m.scale!.max) - b.from};background:${b.color}`} />
                  ))}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap sec flow" aria-labelledby="flow-h">
    <h2 id="flow-h">How your data gets to Pulse</h2>
    <div class="flow-body">
      <span class="flow-track" aria-hidden="true"></span>
      <ol class="flow-list">
        {
          flow.map((f) => (
            <li>
              <span class="f-name">{f.name}</span>
              <span class="f-detail">{f.detail}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="wrap sec privacy" aria-labelledby="privacy-h">
    <div class="panel">
      <h2 id="privacy-h">Your health data stays on a machine you control.</h2>
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.t}</dt>
              <dd>{f.d}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="wrap sec start" aria-labelledby="start-h">
    <h2 id="start-h">Get started</h2>
    <p class="lede">Try the demo on your laptop in a few commands, then point it at your own data. You need Node 24 and pnpm for the demo, Docker for a server.</p>
    <div class="steps">
      <div class="step-card">
        <h3>Try the demo</h3>
        <pre><code>git clone https://github.com/adityaongit/pulse.git
cd pulse
pnpm install
cp .env.example .env
pnpm dev</code></pre>
        <p>Open localhost:3000 and choose Continue with demo data.</p>
      </div>
      <div class="step-card">
        <h3>Run it on a server</h3>
        <pre><code># in .env: Google OAuth client, OWNER_EMAIL, TZ
docker compose up -d --build
docker compose logs -f pulse</code></pre>
        <p>Put a tunnel or HTTPS reverse proxy in front, then open it on your phone.</p>
      </div>
    </div>
    <a class="button button-primary guide" href={SETUP_GUIDE}>Read the setup guide</a>
  </section>

  <section class="wrap sec about" aria-labelledby="about-h">
    <div class="about-text">
      <h2 id="about-h">About this project</h2>
      <p>
        Pulse is made by one independent developer, for the community, and it is free. There is no company behind it, and no intention of competing with WHOOP or anyone
        else.
      </p>
      <p>
        It uses no WHOOP device, data, code or assets. Every score is computed from your own Google Health data, with methods published in full. The interface takes design
        inspiration from apps the developer admires.
      </p>
      <p>
        WHOOP and the other names on this site are trademarks of their owners, and Pulse is not affiliated with or endorsed by them. If you represent WHOOP or any other
        company and have a concern, please email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and it will be changed or taken down.
      </p>
    </div>
    <aside class="credits" aria-labelledby="credits-h">
      <h3 id="credits-h">Open source, noncommercial</h3>
      <p>
        Free to use, change and share for any noncommercial purpose under <a href={LICENSE_URL}>PolyForm Noncommercial 1.0.0</a>. The recovery, strain and sleep scoring
        is ported from <a href="https://github.com/ryanbr/noop">noop</a>, and <a href="https://github.com/bardesss/haelan">Hælan</a>'s notes on the Google Health API saved
        a lot of trial and error.
      </p>
      <h3>Weighing it up?</h3>
      <ul>
        {
          COMPARISONS.map((c) => (
            <li>
              <a href={`/compare/${c.slug}/`}>{c.h1}</a>
            </li>
          ))
        }
      </ul>
    </aside>
  </section>

  <div class="wrap sec faq-wrap">
    <Faq items={faq} aside={`Something else? <a href="${REPO}/issues">Ask on GitHub</a>.`} />
  </div>
</Base>

<script>
  // Small, progressive: the page reads complete without it. Adds `in` once a [data-observe] block is seen (dials draw,
  // numbers count up), `live` while it is on screen (the heartbeat runs only then), and the active laptop screen.
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches
  const ease = (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t))

  function countUp(el: HTMLElement) {
    const target = Number(el.dataset.count)
    const digits = (el.dataset.count!.split(".")[1] ?? "").length
    if (still || !Number.isFinite(target)) return
    const t0 = performance.now()
    const tick = (now: number) => {
      const t = Math.min(1, (now - t0) / 1400)
      el.textContent = (target * ease(t)).toFixed(digits)
      if (t < 1) requestAnimationFrame(tick)
    }
    requestAnimationFrame(tick)
  }

  const seen = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const el = e.target as HTMLElement
        el.classList.toggle("live", e.isIntersecting)
        if (e.isIntersecting && !el.classList.contains("in")) {
          el.classList.add("in")
          el.querySelectorAll<HTMLElement>("[data-count]").forEach(countUp)
        }
      }
    },
    { threshold: 0.3 },
  )
  document.querySelectorAll("[data-observe]").forEach((el) => seen.observe(el))

  // The step crossing the middle of the viewport picks the laptop screen.
  const stack = document.querySelector<HTMLElement>(".screen-stack")
  const steps = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting && stack) stack.dataset.active = (e.target as HTMLElement).dataset.step
    },
    { rootMargin: "-50% 0px -50% 0px" },
  )
  document.querySelectorAll(".step").forEach((el) => steps.observe(el))
</script>

<style>
  /* One vertical rhythm for every section; the hero sets its own. */
  .sec {
    margin-top: clamp(104px, 12vw, 168px);
  }
  .sec h2 {
    font-size: clamp(1.875rem, 3.6vw, 2.75rem);
    letter-spacing: -0.03em;
    max-width: 22ch;
  }
  .lede {
    margin-top: 16px;
    max-width: 58ch;
    color: var(--foreground-secondary);
  }
  .lede a {
    color: var(--foreground);
    font-weight: 600;
    white-space: nowrap;
  }

  /* Hero */
  .hero {
    position: relative;
    overflow-x: clip;
    padding: clamp(32px, 5vw, 72px) 0 48px;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 40px;
    align-items: center;
  }
  h1 {
    font-size: clamp(2.5rem, 4.2vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    max-width: 15ch;
  }
  .sub {
    margin-top: 24px;
    max-width: 36ch;
    color: var(--foreground-secondary);
    font-size: clamp(1.125rem, 1.6vw, 1.3125rem);
    line-height: 1.5;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  /* The device pair: a laptop that runs past the column edge, a phone over its lower left corner. Sized in
     percentages of the column, so the composition holds from phone to desktop. */
  .stage {
    position: relative;
    aspect-ratio: 1 / 0.86;
  }
  .layer {
    position: absolute;
  }
  .layer-laptop {
    left: 16%;
    top: 0;
    width: 100%;
  }
  .layer-phone {
    left: 0;
    top: 18%;
    width: 34%;
  }
  .stage :global(.dev) {
    width: 100%;
  }
  .beat {
    position: absolute;
    left: 0;
    bottom: -50px;
    width: 100%;
    height: 200px;
    pointer-events: none;
  }
  .beat path {
    fill: none;
    stroke: var(--optimal);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .beat-base {
    stroke-opacity: 0.22;
  }
  .beat-pulse {
    stroke-opacity: 0;
    stroke-dasharray: 0.14 0.86;
  }

  /* Dials */
  .dial-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }
  .dial {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 36px 24px 32px;
    border-radius: 28px;
    background: radial-gradient(120% 80% at 50% 0%, rgb(255 255 255 / 0.045), transparent 70%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
    text-align: center;
    text-decoration: none;
    transition: background-color 200ms var(--ease-standard);
  }
  .dial:hover {
    background-color: rgb(255 255 255 / 0.03);
  }
  .ring {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 220px);
    aspect-ratio: 1;
    margin-bottom: 14px;
  }
  .ring svg {
    position: absolute;
    inset: 0;
    rotate: -90deg;
  }
  .ring circle {
    fill: none;
    stroke-width: 12;
  }
  .track {
    stroke: rgb(255 255 255 / 0.09);
  }
  .arc {
    stroke: var(--c);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - var(--p));
    transition: stroke-dashoffset 1400ms var(--ease-out-expo);
  }
  :global(html.js) .dials:not(.in) .arc {
    stroke-dashoffset: 100;
  }
  .value {
    position: relative;
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .value small {
    margin-left: 2px;
    font-size: 0.42em;
    font-weight: 600;
    color: var(--foreground-secondary);
  }
  .d-name {
    font-weight: 650;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    transition: color 150ms var(--ease-standard);
  }
  .dial:hover .d-name {
    color: var(--c);
  }
  .d-line {
    max-width: 28ch;
    color: var(--foreground-secondary);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .note {
    margin-top: 24px;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  /* Phone strip */
  .screens {
    padding: clamp(72px, 9vw, 120px) 0;
    background: radial-gradient(80% 60% at 75% 0%, #14302d 0%, transparent 70%), var(--sheet);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), inset 0 -1px 0 rgb(255 255 255 / 0.06);
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    width: min(100% - 2 * var(--gutter), var(--page));
    margin: 56px auto 0;
    padding: 0;
    list-style: none;
  }
  .strip figure {
    margin: 0;
  }
  .strip li:nth-child(even) {
    padding-top: 48px;
  }
  .strip figcaption {
    margin-top: 10px;
    padding-inline: 8%;
    color: var(--foreground-secondary);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .strip figcaption strong {
    display: block;
    color: var(--foreground);
    font-weight: 600;
  }

  /* Story: steps scroll on the left, the laptop stays and changes screen on the right */
  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: 48px;
    margin-top: 24px;
  }
  .steps-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: grid;
    align-content: center;
    gap: 10px;
    min-height: 46vh;
    padding: 24px 0;
    transition: opacity 300ms var(--ease-standard);
  }
  :global(html.js) .step {
    opacity: 0.4;
  }
  .step h3 {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .step p {
    max-width: 36ch;
    color: var(--foreground-secondary);
  }
  .step :global(.inline-shot) {
    display: none;
  }
  .story-grid:has(.screen-stack[data-active="0"]) .step[data-step="0"],
  .story-grid:has(.screen-stack[data-active="1"]) .step[data-step="1"],
  .story-grid:has(.screen-stack[data-active="2"]) .step[data-step="2"],
  .story-grid:has(.screen-stack[data-active="3"]) .step[data-step="3"] {
    opacity: 1;
  }
  /* Centred in the viewport below the header: the framed laptop is 0.671 of its width tall. */
  .screen-stack {
    position: sticky;
    top: max(80px, calc(50vh + 32px - 0.232 * (min(100vw - 80px, 1180px) - 48px)));
